# Text files get LF line endings. "text=auto" lets git decide what is text: a rule that forces every
# file to be text (the old "* text eol=lf") stripped bytes out of PSDs and zips and corrupted them.
* text=auto eol=lf

# Ensure consistent LF endings for data files
*.csv text eol=lf

# Binary assets: never touch their bytes
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
